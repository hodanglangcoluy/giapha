rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // GIA PHẢ RIÊNG TƯ: chỉ quản trị viên và tài khoản đã được quản trị viên duyệt mới đọc, ghi được.

    // Danh sách quản trị viên. Sửa email cho đúng, giống ADMIN_EMAILS trong firebase-config.js.
    function admin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['wellmat2023@gmail.com','sanhnguyendang@gmail.com','ntr.tin159@gmail.com'];
    }
    function signedIn() { return request.auth != null; }
    // Tài khoản đã được quản trị viên cho phép xem (users/{uid}.status == 'approved')
    function approved() {
      return admin()
        || (signedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved');
    }
    function mine()  { return signedIn() && resource.data.uid == request.auth.uid; }
    function myNew() { return approved() && request.resource.data.uid == request.auth.uid; }

    // Tài khoản người xem. Mỗi người tự tạo hồ sơ của mình với trạng thái chờ duyệt;
    // chỉ quản trị viên được đổi trạng thái.
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','email','name','status','at'])
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == request.auth.uid;
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow update, delete: if admin();
    }

    // Dữ liệu gốc của gia phả (nạp bởi quản trị viên từ tệp members.json).
    match /base/{id} {
      allow read: if approved();
      allow write: if admin();
    }

    // Thông tin bổ sung đã được duyệt (có thể gồm điện thoại, địa chỉ)
    match /overrides/{id} {
      allow read: if approved();
      allow write: if admin();
    }

    // Người mới được duyệt thêm vào phả hệ (con, vợ, chồng)
    match /newmembers/{id} {
      allow read: if approved();
      allow write: if admin();
    }

    // Yêu cầu cập nhật: người đã được duyệt gửi được; chỉ quản trị viên và chính người gửi xem được;
    // chỉ quản trị viên duyệt hoặc từ chối.
    match /requests/{id} {
      allow create: if myNew()
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['rid','pid','pidn','field','value','by','rel','contact','note','status','at','uid','person','target'])
        && request.resource.data.value is string && request.resource.data.value.size() <= 2000
        && (!('person' in request.resource.data) || request.resource.data.person is map);
      allow read: if admin() || (approved() && mine());
      allow update, delete: if admin();
    }

    // Ảnh của từng người
    match /photos/{id} {
      allow read: if approved();
      allow create: if myNew() && request.resource.data.d is string && request.resource.data.d.size() < 300000;
      allow update: if ((approved() && mine() && myNew()) || admin()) && request.resource.data.d.size() < 300000;
      allow delete: if (approved() && mine()) || admin();
    }

    // Ảnh tư liệu trên trang chủ
    match /gallery/{id} {
      allow read: if approved();
      allow create: if myNew() && request.resource.data.d is string && request.resource.data.d.size() < 400000;
      allow update: if ((approved() && mine() && myNew()) || admin()) && request.resource.data.d.size() < 400000;
      allow delete: if (approved() && mine()) || admin();
    }

    // Blog
    match /posts/{id} {
      allow read: if approved();
      allow create: if myNew()
        && request.resource.data.keys().hasOnly(['t','b','a','c','im','at','uid'])
        && request.resource.data.t is string && request.resource.data.t.size() <= 200
        && request.resource.data.b is string && request.resource.data.b.size() <= 8000
        && request.resource.data.im.size() <= 4;
      allow update: if admin();
      allow delete: if (approved() && mine()) || admin();
    }

    // Lịch sự kiện
    match /events/{id} {
      allow read: if approved();
      allow create: if myNew()
        && request.resource.data.keys().hasOnly(['t','k','tm','pl','nt','by','at','dt','ld','lm','uid'])
        && request.resource.data.t is string && request.resource.data.t.size() <= 100;
      allow update: if admin();
      allow delete: if (approved() && mine()) || admin();
    }

    // Đăng ký tham dự
    match /rsvps/{id} {
      allow read: if approved();
      allow create: if myNew()
        && request.resource.data.keys().hasOnly(['e','o','n','k','at','uid'])
        && request.resource.data.n is string && request.resource.data.n.size() <= 80;
      allow update: if false;
      allow delete: if (approved() && mine()) || admin();
    }
  }
}
